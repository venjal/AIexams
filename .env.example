# Copy this file to .env and fill in your values only if you want /chat.
# Quiz and flashcard pages work without these settings.
# Example endpoint format:
# https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project-name>
PROJECT_ENDPOINT=

# Preferred: agent ID from Foundry portal (Build > Agents)
AGENT_ID=

# Optional fallback: exact agent name from Foundry portal
AGENT_NAME=
